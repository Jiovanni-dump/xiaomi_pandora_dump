  "titles": {
    "zh_HK": "小米龍鱗纖維殼專屬",
    "zh_TW": "小米龍鱗纖維殼專屬",
    "bo_CN": "ཞའོ་མཱི་འབྲུག་ཁྲབ་ཚི་སྣའི་སྐོགས་ཀྱི་ཆེད་གཏོགས་།",
    "en_US": "Dragon scale fiber",
    "ug_CN": "شياۋمى لوڭلىڭ مەخسۇس",
    "zh_CN": "小米龙鳞纤维壳专属",
    "fallback": "小米龙鳞纤维壳专属"
